{
  "entities": {
    "users": {
      "title": "users",
      "description": "User profiles, activation statuses, roles, and culinary training progress.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "superadmin", "admin", "trainer", "staff", "student"] },
        "status": { "type": "string", "enum": ["pending", "active", "approved", "suspended", "blocked"] },
        "assignedBatchId": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "progress": {
          "type": "object",
          "properties": {
            "enrolledCourses": { "type": "array", "items": { "type": "string" } },
            "completedLessons": { "type": "array", "items": { "type": "string" } },
            "quizScores": { "type": "object" },
            "customRecipes": { "type": "array" },
            "badges": { "type": "array" }
          }
        }
      },
      "required": ["id", "name", "email", "status"]
    },
    "batches": {
      "title": "batches",
      "description": "Culinary training cohorts and course batches.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "trainerId": { "type": "string" },
        "trainerName": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "active", "completed", "cancelled"] }
      },
      "required": ["id", "name", "courseId", "trainerId", "status"]
    },
    "enrollments": {
      "title": "enrollments",
      "description": "Student course enrollment applications, reviews, and admissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "batchId": { "type": "string" },
        "status": { "type": "string", "enum": ["applied", "pending_payment", "payment_submitted", "under_review", "approved", "active", "completed", "cancelled", "rejected"] },
        "totalFee": { "type": "number" },
        "paidAmount": { "type": "number" },
        "appliedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "courseId", "status"]
    },
    "attendance": {
      "title": "attendance",
      "description": "Daily practical and theoretical attendance logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "batchId": { "type": "string" },
        "courseId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "late", "excused"] },
        "markedBy": { "type": "string" }
      },
      "required": ["id", "batchId", "studentId", "date", "status"]
    },
    "assignments": {
      "title": "assignments",
      "description": "Culinary coursework, knife portfolios, and HACCP assignments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "batchId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string" },
        "maxMarks": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "courseId", "title", "dueDate", "maxMarks"]
    },
    "certificates": {
      "title": "certificates",
      "description": "Verifiable accredited digital culinary diplomas and certificates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "certificateNumber": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "issueDate": { "type": "string" },
        "grade": { "type": "string" },
        "isValid": { "type": "boolean" }
      },
      "required": ["id", "certificateNumber", "studentId", "courseId", "isValid"]
    },
    "audit_logs": {
      "title": "audit_logs",
      "description": "Immutable security and administrative actions audit trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "targetUid": { "type": "string" },
        "targetResource": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "actorUid", "actorName", "actorRole", "action", "timestamp"]
    }
  }
}
