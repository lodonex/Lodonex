{
  "entities": {
    "users": {
      "title": "users",
      "description": "User profiles, activation statuses, and culinary training progress.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "progress": {
          "type": "object",
          "properties": {
            "enrolledCourses": { "type": "array", "items": { "type": "string" } },
            "completedLessons": { "type": "array", "items": { "type": "string" } },
            "quizScores": { "type": "object" },
            "customRecipes": { "type": "array" },
            "badges": { "type": "array" }
          }
        }
      },
      "required": ["id", "name", "email", "status", "progress"]
    },
    "reviews": {
      "title": "reviews",
      "description": "Student reviews and feedback for courses.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "rating": { "type": "number" },
        "feedback": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "courseId", "studentId", "rating", "feedback"]
    },
    "recipes": {
      "title": "recipes",
      "description": "Custom recipes created and persisted by students.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleBn": { "type": "string" },
        "categoryEn": { "type": "string" },
        "categoryBn": { "type": "string" },
        "prepTime": { "type": "string" },
        "cookTime": { "type": "string" },
        "servings": { "type": "number" },
        "ingredientsEn": { "type": "array", "items": { "type": "string" } },
        "ingredientsBn": { "type": "array", "items": { "type": "string" } },
        "stepsEn": { "type": "array", "items": { "type": "string" } },
        "stepsBn": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" }
      },
      "required": ["id", "titleEn", "ingredientsEn", "stepsEn"]
    },
    "applications": {
      "title": "applications",
      "description": "Student enrollment and admission inquiries.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "courseId", "name", "email"]
    }
  }
}
