# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Merchant Local Payment Gateway Configuration (bKash / Nagad / Rocket / Local Bank)
MERCHANT_BKASH_NUMBER="+8801700000000"
MERCHANT_NAGAD_NUMBER="+8801800000000"
MERCHANT_ROCKET_NUMBER="+8801900000000"
MERCHANT_BANK_NAME="Eastern Bank PLC (EBL)"
MERCHANT_BANK_ACC_NAME="Lodonex Cooking Academy Ltd."
MERCHANT_BANK_ACC_NUM="101234567890"
MERCHANT_BANK_BRANCH="Gulshan Branch, Dhaka"
MERCHANT_BANK_ROUTING="085261728"

# Direct bKash Online API Credentials (Optional Live Merchant Gateway Integration)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# SSLCommerz Card Payment Gateway Credentials (Optional)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX="true"

